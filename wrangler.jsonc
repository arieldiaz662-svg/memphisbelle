// Cloudflare Workers (Worker "memphisbelle"): pasa los tests, construye la web estática y publica dist/.
// Si falla un test, no se publica. Tampoco se publica mientras queden datos pendientes en site.js
// (CHECK_PUBLICACION=1, ver test/publicacion.test.js).
// Sin dominio propio todavía: la web queda en memphisbelle.<cuenta>.workers.dev. Al tener dominio, añadir
// "routes" (dominio y www, con custom_domain), PUBLIC_BASE_URL en el comando y el dominio en
// worker/redireccion.js.
{
  "name": "memphisbelle",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "CHECK_PUBLICACION=1 npm test && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
