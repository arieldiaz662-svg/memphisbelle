// Cloudflare Workers (Worker "memphisbelle"): pasa los tests, construye la web estática y publica dist/.
// Si falla un test, no se publica. Tampoco se publica mientras queden datos pendientes en site.js
// (CHECK_PUBLICACION=1, ver test/publicacion.test.js).
// Mientras no haya dominio propio, la web se sirve en la dirección de workers.dev (sin routes y sin PUBLIC_BASE_URL, así
// que no se generan canonical ni sitemap). Cuando el bar tenga dominio: node scripts/cambiar-dominio.js midominio.com
// (cambia DOMINIO en worker/redireccion.js, routes y PUBLIC_BASE_URL). workers_dev fija la dirección de workers.dev
// activada en cada despliegue (con routes, Wrangler la apagaba y la web dejaba de responder ahí).
{
  "name": "memphisbelle",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "build": {
    "command": "CHECK_PUBLICACION=1 npm test && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
